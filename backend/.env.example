# Локальный PostgreSQL из docker compose в корне репозитория.
DATABASE_URL=postgres://adolesson:adolesson@localhost:5432/adolesson
PORT=5001

# Прод в Yandex Cloud. Секреты сюда не кладут, только в окружение сервиса.
# DATABASE_URL=postgres://user:password@<host>:6432/adolesson?sslmode=require
# COOKIE_SECURE=1
# CORS_ORIGIN=https://<адрес-статического-фронта>
# Несколько адресов — через запятую. Без CORS_ORIGIN фронт и API на одном сайте.
